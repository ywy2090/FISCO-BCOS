{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "specs-tests manifest",
  "type": "object",
  "required": ["manifestVersion", "entries"],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidenceId",
          "sourceSuite",
          "casePath",
          "forkProfileId",
          "path",
          "evidenceKind",
          "capabilityRowIds",
          "assertLevels"
        ],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "sourceSuite": { "type": "string", "enum": ["ethereum-tests", "eest", "op-geth-golden"] },
          "casePath": { "type": "string", "minLength": 1 },
          "variantKey": {
            "type": "string",
            "minLength": 1,
            "description": "Optional GST map key when casePath JSON contains multiple named variants. Omit when the file has a single variant or uses legacy single-object layout."
          },
          "forkProfileId": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "enum": ["Reference", "BcosBaseline", "OpStackBaseline"]
          },
          "evidenceKind": {
            "type": "string",
            "enum": [
              "ReferenceParity",
              "BaselineReachability",
              "DeviationAssertion",
              "UpstreamLiteralParity"
            ]
          },
          "capabilityRowIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "assertLevels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["transitional", "expectException", "stateRoot", "logsHash"]
            }
          },
          "postFork": {
            "type": "string",
            "minLength": 1,
            "description": "Optional GST post fork key when upstream JSON lacks post for forkProfileId (e.g. Osaka smoke uses Prague post until submodule pin includes Osaka)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
