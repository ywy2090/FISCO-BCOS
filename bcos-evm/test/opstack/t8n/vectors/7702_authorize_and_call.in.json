  "isthmus_7702_authorize_and_call": {
    "_info": {
      "id": "isthmus_7702_authorize_and_call",
      "comment": "SPONSOR (addr2) sends a type-0x04 tx authorizing AUTH (addr3, an empty/fresh EOA) to delegate to MARKER (a 6-byte contract that SSTOREs 42 to slot0), and the tx's own `to` targets AUTH itself -- so within the *same* tx, AUTH's delegation installs first (EIP-7702 authorization processing precedes the top-level call) and then the top-level CALL to AUTH executes MARKER's code in AUTH's own storage/balance context. Checks: AUTH.code becomes the 23-byte delegation indicator (0xef0100 || MARKER), AUTH.nonce bumps from 0 to 1 (one authorization consumed), and AUTH's slot0 becomes 42 (delegated code actually ran).",
      "source": "opt8n",
      "hardforks": [
        "isthmus"
      ],
